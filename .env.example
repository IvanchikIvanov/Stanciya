# База данных: оставьте пустым для локального PGlite (./.pglite) или укажите postgres://...
DATABASE_URL=

# Папка для загружаемых изображений товаров
UPLOAD_DIR=./uploads

# Настройки раздела 16 (дополнительные бизнес-правила)
MAX_ACTIVE_ORDERS_PER_PHONE=2
ENABLE_NO_SHOW_COUNTER=true

# Учётные данные сотрудников для сидов (npm run seed)
SEED_ADMIN_LOGIN=admin_stanciya
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_BARISTA1_LOGIN=barista_avtozavod
SEED_BARISTA1_PASSWORD=ChangeMeBarista1!
SEED_BARISTA2_LOGIN=barista_mashgorodok
SEED_BARISTA2_PASSWORD=ChangeMeBarista2!
